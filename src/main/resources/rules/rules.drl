package rules;

import com.udea.drools.model.Passenger;
import com.udea.drools.model.Flight;
import com.udea.drools.model.Luggage;
import com.udea.drools.model.Seat;
import com.udea.drools.model.Response;
import com.udea.drools.model.Request;

rule "1. UpgradeToBusinessClassForFrequentFlyersWithDelays"
when
    $request : Request($passenger : passenger)
    eval($passenger.getFlight() != null && $passenger.getFlight().getDelay() > 60)
    eval( $passenger.getStatus() == "Gold" || $passenger.getStatus() == "Platinum")
    $response : Response()
then
    $passenger.setEligibleForUpgrade(true);
    $response.setPassenger($passenger);
end

rule "2. PriorityCheckInForSeniors"
when
    $request : Request($passenger : passenger)
    $response : Response()
    $passenger : Passenger(age > 65)
then
    $passenger.setPriorityCheckIn(true);
    $response.setPassenger($passenger);
end

rule "3. DiscountForLightLuggage"
when
    $request : Request($passenger : passenger)
    $response : Response()
    $passenger : Passenger(luggage.weight < 10)
then
    $passenger.getLuggage().setDiscount(0.10);
    $response.setPassenger($passenger);
end

rule "4. DenyUpgradeForOverweightLuggage"
when
    $request : Request($passenger : passenger)
    $response : Response()
    $passenger : Passenger(luggage.weight > 23)
then
    $passenger.setEligibleForUpgrade(false);
    $response.setPassenger($passenger);
end

rule "5. AssignEmergencyExitSeatToYoungAdults"
when
    $request : Request($passenger : passenger)
    $response : Response()
    $passenger : Passenger(age >= 18 && age <= 40, seatPreference == "Any")
    $seat : Seat(type == "EmergencyExit", available == true)
then
    $seat.setAvailable(false);
    $passenger.setAssignedSeat($seat);
    $response.setPassenger($passenger);
end

rule "6. CompensationForExtremeDelays"
when
    $request : Request($passenger : passenger)
    $response : Response()
    $passenger : Passenger(flight.delay > 180)
then
    $passenger.setCompensation(200.0);
    $response.setPassenger($passenger);
end

rule "7. ExtraLoyaltyPointsForLongFlights"
when
    $request : Request($passenger : passenger)
    $response : Response()
    $passenger : Passenger(status != "Basic", flight.duration > 5)
then
    $passenger.addLoyaltyPoints(500);
    $response.setPassenger($passenger);
end

rule "8. RestrictLuggageOnShortFlights"
when
    $request : Request($passenger : passenger)
    $response : Response()
    $passenger : Passenger(luggage.weight > 15, flight.duration < 2)
then
    $passenger.getLuggage().setAllowed(false);
    $response.setPassenger($passenger);
end

rule "9. VipLoungeAccessForPlatinumMembers"
when
    $request : Request($passenger : passenger)
    $response : Response()
    $passenger : Passenger(status == "Platinum")
then
    $passenger.setVipAccess(true);
    $response.setPassenger($passenger);
end

rule "10. PreferentialSeatForFamilies"
when
    $request : Request($passenger : passenger)
    $response : Response()
    $passenger : Passenger(travelingWithChildren == true, seatPreference == null || seatPreference == "")
    $seat : Seat(type == "Familiar", available == true)
then
    $seat.setAvailable(false);
    $passenger.setAssignedSeat($seat);
    $response.setPassenger($passenger);
end
package rules

import com.udea.drools.model.Customer
import com.udea.drools.model.CreditRequest
import com.udea.drools.model.CreditResponse

// Regla 1
rule "UpgradeToBusinessClassForFrequentFlyersWithDelays:"
when
    $passenger : Passenger(status == "Gold" || status == "Platinum")
    $flight : Flight(delay > 60)
then
    $passenger.setUpgradeToBusinessClass(true);
end

// Regla 2
rule "PriorityCheckInForSeniors"
when
    $passenger : Passenger(age > 65)
then
    $passenger.setPriorityCheckIn(true);
end

// Regla 3
rule "DiscountForLightLuggage"
when
    $luggage : Luggage(weight < 10)
then
    $luggage.setDiscount(10); // Apply 10% discount
end

// Regla 4
rule "DenyUpgradeForOverweightLuggage"
when
    $luggage : Luggage(weight > 23)
then
    $luggage.setEligibleForUpgrade(false);
end

// Regla 5
rule "AssignEmergencyExitSeatToYoungAdults"
when
    $passenger : Passenger(age >= 18 && age <= 40, seatPreference == "Any")
    $seat : Seat(type == "EmergencyExit", available == true)
then
    $passenger.setAssignedSeat($seat);
    $seat.setOccupied(true);
end

// Regla 6
rule "CompensationForExtremeDelays"
when
    $flight : Flight(delay > 180)
then
    $passenger.setCompensation(200); // Grant $200 compensation
end

// Regla 7
rule "ExtraLoyaltyPointsForLongFlights"
when
    $passenger : Passenger(membership != "Basic")
    $flight : Flight(duration > 5)
then
    $passenger.addLoyaltyPoints(500); // Add 500 loyalty points
end

// Regla 8
rule "RestrictLuggageOnShortFlights"
when
    $luggage : Luggage(weight > 15)
    $flight : Flight(duration < 2)
then
    $luggage.setAllowed(false); // Mark luggage as not allowed
end

// Regla 9
rule "VipLoungeAccessForPlatinumMembers"
when
    $passenger : Passenger(status == "Platinum")
then
    $passenger.setVipLoungeAccess(true);
end

// Regla 10
rule "PreferentialSeatForFamilies"
when
    $passenger : Passenger(travelingWithChildren == true, seatPreference == null)
then
    $passenger.setAssignedSeat("FamilyPreferred");
end